    "rounding": "nearest 1000 generations; exact .5 tie uses Python round-to-even but no prespecified configuration is an exact .5 tie"
  },
  "GA": {
    "architecture": "same the prespecified GA: random initialization; binary tournament; fixed-cardinality OBX k=floor(n/2); insertion mutation; elitism=1; generational replacement; no LS",
