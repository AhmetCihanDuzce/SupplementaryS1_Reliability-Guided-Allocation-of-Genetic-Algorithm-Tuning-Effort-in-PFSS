  "decision_rule": {
    "historical_evidence": "nine Taillard group 3->7 fresh near-optimal counts: 749,775,720,824,656,613,837,814,595 out of 840 in (20,50,100)x(5,10,20) order",
    "interpolation": "bilinear interpolation in (log n, log m) of exact historical safe-transfer proportions",
    "GREEN": "interpolated historical safe-transfer proportion >= 0.90; reuse interpolated/snap-to-grid center configuration without tuning",
    "AMBER": "0.75 <= interpolated historical safe-transfer proportion < 0.90; local sequential DoE around center configuration",
    "RED": "interpolated historical safe-transfer proportion < 0.75; broad/full 5x5x5 retuning",
    "important": "the earlier predicted response-surface sharpness and structural descriptors are recorded as secondary explanatory variables but DO NOT alter GREEN/AMBER/RED action because H3 was not externally supported."
  },
  "center_parameter_rule": {
    "anchors": "nine previously prespecified transferred configurations",
