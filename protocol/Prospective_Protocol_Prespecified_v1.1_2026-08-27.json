  "AMBER_policy": {
    "local_neighborhood": "one grid step below/center/one above for each of pop_mult, pc, pm, clipped at boundaries; Cartesian product, at most 27 configurations",
    "stage1": "R=3 on every local configuration; rank by mean Cmax ascending, tie by pop_mult then pc then pm ascending",
    "promotion": "top 5 local configurations, or all configurations if fewer than 5, promoted to total R=10 by adding reps 4..10",
    "final_selection": "minimum 10-rep mean Cmax among promoted configurations; same deterministic parameter tie-break"
  },
  "RED_policy": {
    "full_retuning": "125 configurations x R=10 using policy-tuning seed family; select minimum 10-rep mean Cmax with deterministic parameter tie-break"
  },
  "seed_families": {
    "policy_tuning_base": 2800000201,
    "hidden_benchmark_base": 2810000201,
    "fresh_validation_base": 2820000201,
    "formula": "base + target_index*100000 + rep*1009; same rep seed across compared configurations within a target (CRN)"
  },
  "hidden_ground_truth": {
    "procedure": "after policy action and selected configuration are prespecified for a target, run an independent hidden full 125-configuration x R=10 benchmark surface using hidden_benchmark seeds and select the empirical oracle by minimum mean Cmax",
    "leakage_guard": "hidden surface is not visible to GREEN/AMBER/RED policy selection"
  },
  "fresh_validation": {
    "R": 10,
    "CRN": "same fresh seed for policy-selected configuration, hidden empirical oracle, and optional shadow direct-center configuration",
    "signed_excess_pp": "100*(mean Cmax_policy - mean Cmax_hidden_oracle)/NEH",
    "safe": "signed_excess_pp <= 0.25",
    "shadow_direct_center": "evaluate center configuration on fresh seeds for all AMBER/RED targets for decision-value diagnostics; does not alter action"
  },
  "primary_endpoints": {
    "primary_efficacy_regret": "Across all 24 targets, compare policy-selected vs shadow direct-center fresh clipped regret at target level with a one-sided paired Wilcoxon signed-rank test (alternative: policy lower), alpha=0.05.",
    "primary_efficacy_failures": "Across all 24 targets, compare safe/fail status of policy vs shadow direct-center with exact paired McNemar/binomial discordant-pair test (alternative: policy reduces failures), alpha=0.05. Report Holm-adjusted p-values across the two co-primary efficacy tests.",
    "overall_policy_safety": "Report safe count/rate (SE<=0.25 pp), exact/Wilson 95% CI, mean signed excess and mean clipped regret. No post-outcome pass/fail threshold will be introduced.",
    "GREEN_precision": "Report safe count/rate, false-GREEN count, and exact/Wilson 95% CI for the 8 preassigned GREEN targets. No hard 8/8 requirement.",
    "AMBER_performance": "Report safe count/rate, exact/Wilson 95% CI, and rescue rate among shadow direct-center failures for the 12 preassigned AMBER targets. No hard 11/12 requirement.",
    "RED_diagnostic": "Report shadow direct-center failures, selected-config regret and cost for 4 preassigned RED targets; no separate pass threshold.",
    "cost": "Report practitioner policy-tuning GA runs and ratio versus 24*1250 full-grid runs. Hidden benchmark and final fresh-validation runs are scientific evaluation cost and excluded from practitioner tuning cost."
  },
  "secondary_endpoints": [
    "overall near-optimal rate and 95% CI",
